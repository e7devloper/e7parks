PORT=4000

# 32+ random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Login for the staff dashboard at /internal
ADMIN_USER=admin
ADMIN_PASSWORD=

# Email (OTP codes + ticket confirmations). Leave SMTP_HOST empty in development
# and emails are printed in the server terminal instead of being sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=E7 Entertainments <no-reply@e7entertainments.com>

# Shown on the public privacy policy (/privacy) and account deletion (/delete-account) pages.
SUPPORT_EMAIL=

# Optional: also POST each new ticket as JSON to another internal system.
INTERNAL_WEBHOOK_URL=
INTERNAL_WEBHOOK_TOKEN=

# Set to 1 when running behind a reverse proxy (nginx, Render, Railway...).
TRUST_PROXY=
